# Ambiguous Sheets persistence (server-side only; never commit real values).
AMBIGUOUS_API_KEY=
LOCI_AMBIGUOUS_SHEET_ID=
# A finite range is required by Ambiguous; use the tab created for the event log.
LOCI_AMBIGUOUS_RANGE=Events!A1:M1
# Optional overrides for local testing.
# AMBIGUOUS_API_BASE=https://app.ambiguous.ai/api
# LOCI_AMBIGUOUS_TAB=Events
